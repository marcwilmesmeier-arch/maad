# HTTPS für maad. Domain anpassen; Caddy holt das Zertifikat automatisch (Domain muss auf den Server zeigen).
www.getmaad.de {
	redir https://getmaad.de{uri} permanent
}

getmaad.de {
	encode zstd gzip
	request_body {
		max_size 250MB
	}
	reverse_proxy 127.0.0.1:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output file /var/log/caddy/maad.log {
			roll_size 20MiB
			roll_keep 10
		}
	}
}
